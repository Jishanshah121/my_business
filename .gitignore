# Environment & secrets
.env
.env.*
!.env.example

# Dependencies
/vendor/
/node_modules/
python-service/.venv/
python-service/**/__pycache__/
*.pyc

# Build output
/public/build/*
!/public/build/.gitkeep

# Runtime storage (keep the directories, ignore the contents)
/storage/logs/*
/storage/cache/*
/storage/uploads/*
/storage/invoices/*
/storage/exports/*
!/storage/**/.gitkeep

# Tooling
.phpunit.result.cache
.phpunit.cache/
.phpstan.cache/
coverage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
