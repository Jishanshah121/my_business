{
    "name": "supplykaro/platform",
    "description": "SupplyKaro — B2B + B2C disposables, food-service and event supplies platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/console migrate",
        "seed": "php bin/console db:seed",
        "fresh": "php bin/console migrate:fresh --force --seed",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs --standard=PSR12 app/ database/ tests/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
