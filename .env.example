# ============================================================================
#  SupplyKaro — environment configuration
#  Copy to .env and fill in. NEVER commit .env.
# ============================================================================

APP_NAME="SupplyKaro"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # MUST be false in production
APP_URL=http://localhost:8000
APP_KEY=                      # 32-byte base64 key: php bin/console key:generate
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en_IN

# --- Database -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=supplykaro
DB_USERNAME=supplykaro
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# Read-only user consumed by the Python AI service. No write grants.
DB_READONLY_USERNAME=supplykaro_ai
DB_READONLY_PASSWORD=

# --- Redis (sessions, cache, queue, rate limiting) ----------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Session & security -------------------------------------------------
SESSION_DRIVER=file           # file | redis
SESSION_LIFETIME=120          # minutes of idle time
SESSION_ABSOLUTE_LIFETIME=720 # minutes, regardless of activity
SESSION_COOKIE=supplykaro_session
SESSION_SECURE_COOKIE=false   # true in production (HTTPS only)
CSRF_TOKEN_LIFETIME=120

# --- Seller identity & GST ----------------------------------------------
# Admin-configurable at runtime via the `settings` table; these are the
# bootstrap defaults used by seeders and by any pre-database code path.
SELLER_LEGAL_NAME="Jishan Shah"
SELLER_TRADE_NAME="SupplyKaro"
SELLER_GSTIN=27AAAAA0000A1Z5          # PLACEHOLDER — replace with the real GSTIN
SELLER_PAN=AAAAA0000A                 # PLACEHOLDER
SELLER_STATE_CODE=27                  # 27 = Maharashtra
SELLER_STATE_NAME=Maharashtra
SELLER_PINCODE=400001
GST_ENABLED=true
GST_PRICES_INCLUDE_TAX=false          # storage convention; display is per customer group
INVOICE_PREFIX=INV
INVOICE_FY_START_MONTH=4              # Indian financial year starts in April

# --- Mail ---------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025                # Mailhog in local dev
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@supplykaro.test
MAIL_FROM_NAME="SupplyKaro"

# --- Payments (Phase 4 — leave blank until then) ------------------------
PAYMENT_DEFAULT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Python AI service (Phase 8 — not required before then) -------------
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_SHARED_SECRET=
AI_SERVICE_TIMEOUT_MS=300
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN=30

# --- Storage / uploads --------------------------------------------------
UPLOAD_MAX_BYTES=5242880      # 5 MB
UPLOAD_DISK=local             # local | s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- WhatsApp / SMS (Phase 9) -------------------------------------------
WHATSAPP_BUSINESS_NUMBER=919999999999   # PLACEHOLDER, digits only with country code
SMS_PROVIDER=
SMS_API_KEY=

# --- Logging ------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=debug               # debug | info | warning | error
